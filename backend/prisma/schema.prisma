generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
}

enum UserClinicRoleType {
  CLINIC_ADMIN
  DENTIST
  RECEPTION
  PATIENT
}

enum AppointmentStatus {
  /// Pedido do paciente aguardando aprovação da clínica
  REQUESTED
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ClinicPatientStatus {
  ACTIVE
  ARCHIVED
}

model Clinic {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  timezone  String       @default("America/Sao_Paulo")
  status    ClinicStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  roles           UserClinicRole[]
  professionals   Professional[]
  services        Service[]
  clinicPatients  ClinicPatient[]
  appointments    Appointment[]
  documents       Document[]
  clinicalNotes   ClinicalNote[]
  patientCharts   PatientChart[]
  auditLogs       AuditLog[]
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  isPlatformAdmin  Boolean   @default(false)
  consentAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  roles            UserClinicRole[]
  patientProfile   PatientProfile?
  professionals    Professional[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  authoredNotes    ClinicalNote[]
  issuedDocuments  Document[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserClinicRole {
  id       String              @id @default(cuid())
  userId   String
  clinicId String
  role     UserClinicRoleType
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic   Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId, role])
  @@index([clinicId])
  @@index([userId])
}

model PatientProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  phone       String?
  birthDate   DateTime?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  clinicPatients ClinicPatient[]
  appointments   Appointment[]
  documents      Document[]
  clinicalNotes  ClinicalNote[]
  charts         PatientChart[]
}

/// Ficha clínica por clínica (dados pessoais, anamnese, odontograma, plano)
model PatientChart {
  id               String   @id @default(cuid())
  clinicId         String
  patientProfileId String
  chartNumber      String?
  maritalStatus    String?
  phoneHome        String?
  phoneWork        String?
  phoneMobile      String?
  address          String?
  insurance        String?
  referredBy       String?
  allergyAntibiotic Boolean @default(false)
  allergyAnesthetic  Boolean @default(false)
  allergyDetails     String?
  medSensitivity     Boolean?
  medSensitivityDetails String?
  highBloodPressure  Boolean?
  highBloodPressureDetails String?
  takingMedication   Boolean?
  takingMedicationDetails String?
  healthProblems     Boolean?
  healthProblemsDetails String?
  observations       String?
  /// Mapa dente FDI -> status (ex: {"18":"cárie","11":"restauração"})
  odontogram         Json     @default("{}")
  treatmentPlan      String?
  planDate           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  clinic             Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient            PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@unique([clinicId, patientProfileId])
  @@index([clinicId])
}

model ClinicPatient {
  id               String              @id @default(cuid())
  clinicId         String
  patientProfileId String
  status           ClinicPatientStatus @default(ACTIVE)
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  clinic           Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient          PatientProfile      @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@unique([clinicId, patientProfileId])
  @@index([clinicId])
}

model Professional {
  id        String   @id @default(cuid())
  clinicId  String
  userId    String
  cro       String
  specialty String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  services     ProfessionalService[]

  @@unique([clinicId, userId])
  @@index([clinicId])
}

/// Catálogo de tipos de tratamento da clínica, mantido pelo administrador.
model Service {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  /// Descrição padrão da clínica; o dentista pode escrever a própria
  description String?
  durationMin Int
  priceCents  Int
  /// Serviço arquivado deixa de ser oferecido, sem apagar o histórico
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  appointments  Appointment[]
  professionals ProfessionalService[]

  @@index([clinicId])
  @@index([clinicId, active])
}

/// Tratamento que um dentista atende. Descrição, duração e preço em branco
/// herdam o valor do catálogo da clínica.
model ProfessionalService {
  id             String       @id @default(cuid())
  professionalId String
  serviceId      String
  description    String?
  durationMin    Int?
  priceCents     Int?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
  @@index([serviceId])
}

model Appointment {
  id               String            @id @default(cuid())
  clinicId         String
  professionalId   String
  patientProfileId String
  serviceId        String
  startsAt         DateTime
  endsAt           DateTime
  status           AppointmentStatus @default(SCHEDULED)
  /// Motivo informado pelo paciente ao solicitar a consulta
  patientNote      String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  professional     Professional      @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  patient          PatientProfile    @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  service          Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  clinicalNotes    ClinicalNote[]

  @@index([clinicId, startsAt])
  @@index([professionalId, startsAt])
  @@index([patientProfileId, startsAt])
}

/// Documento emitido para o paciente (receita, atestado, declaração, etc).
/// `content` é o texto renderizado na emissão e não é reeditado.
model Document {
  id               String         @id @default(cuid())
  clinicId         String
  patientProfileId String
  /// Profissional que emitiu (identificação obrigatória em receita/atestado)
  authorUserId     String?
  title            String
  type             String
  /// Corpo final do documento, como foi impresso
  content          String?
  /// Campos informados na emissão + snapshot do timbre (clínica, CRO)
  data             Json?
  url              String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  clinic           Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient          PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  author           User?          @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientProfileId])
  @@index([clinicId, createdAt])
}

/// Evolução clínica (prontuário). Após assinada (`signedAt`) torna-se imutável;
/// retificação é feita registrando uma nova evolução.
model ClinicalNote {
  id               String         @id @default(cuid())
  clinicId         String
  patientProfileId String
  /// Profissional responsável pelo registro (exigência de identificação no prontuário)
  authorUserId     String?
  /// Consulta à qual a evolução se refere, quando aplicável
  appointmentId    String?
  body             String
  signedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  clinic           Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient          PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  author           User?          @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  appointment      Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([clinicId, patientProfileId])
  @@index([clinicId, patientProfileId, createdAt])
  @@index([appointmentId])
}

model AuditLog {
  id        String   @id @default(cuid())
  clinicId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
  clinic    Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
}
